{
  "version": 1,
  "notes": "Sector templates for Tenor's intake. Each template defines the questions asked in step 2, their units, the revenue formula behind the live estimate, typical cost lines and the benchmark fields matched against the case library. Default values are illustrative starting points, not benchmarks. Benchmarks come only from cases.json.",
  "asset_classes": {
    "land_improvement": {
      "label": "Land and earthworks",
      "life_years": 25
    },
    "civil_works": {
      "label": "Buildings and civil works",
      "life_years": 25
    },
    "irrigation": {
      "label": "Irrigation and water infrastructure",
      "life_years": 20
    },
    "plant": {
      "label": "Plant and machinery",
      "life_years": 15
    },
    "equipment": {
      "label": "Equipment and vehicles",
      "life_years": 7
    },
    "solar": {
      "label": "Solar, batteries and power systems",
      "life_years": 15
    },
    "it": {
      "label": "Software and IT",
      "life_years": 3
    },
    "livestock_infra": {
      "label": "Livestock housing and processing",
      "life_years": 20
    },
    "other": {
      "label": "Other set-up costs",
      "life_years": 5
    }
  },
  "sectors": [
    {
      "id": "crops",
      "label": "Crops",
      "simple_label": "Growing crops",
      "examples": [
        "Rice",
        "Maize",
        "Soybean",
        "Cassava",
        "Cocoa",
        "Sugarcane",
        "Vegetables"
      ],
      "illustration": "fields",
      "step2_title": "What could your farm produce?",
      "inputs": [
        {
          "key": "hectares",
          "label": "Area planted",
          "simple_label": "Land you'll plant",
          "unit": "hectares",
          "default": 100,
          "benchmark": false
        },
        {
          "key": "crop",
          "label": "Crop",
          "simple_label": "What will you grow?",
          "type": "select",
          "options_from": "examples",
          "default": "Rice"
        },
        {
          "key": "harvests_per_year",
          "label": "Crop cycles per year",
          "simple_label": "Harvests each year",
          "unit": "per year",
          "default": 1,
          "benchmark": true
        },
        {
          "key": "yield_per_ha",
          "label": "Yield per hectare per cycle",
          "simple_label": "Crop from each hectare",
          "unit": "tonnes per harvest",
          "default": 3,
          "benchmark": true
        },
        {
          "key": "price_per_tonne",
          "label": "Farm-gate price",
          "simple_label": "Expected selling price",
          "unit": "per tonne",
          "default": 300,
          "benchmark": true
        },
        {
          "key": "losses_pct",
          "label": "Post-harvest losses",
          "simple_label": "Crop lost before sale",
          "unit": "%",
          "default": 10,
          "hint": "For spoilage, pests or other losses",
          "benchmark": true
        },
        {
          "key": "export_pct",
          "label": "Export share of sales",
          "simple_label": "Share you'll sell abroad",
          "unit": "%",
          "default": 0
        }
      ],
      "revenue_formula": "hectares * harvests_per_year * yield_per_ha * (1 - losses_pct / 100) * price_per_tonne",
      "revenue_explained": "Land planted, times harvests a year, times crop per hectare, less what's lost, times the price per tonne.",
      "cost_lines": [
        {
          "key": "input_cost_per_ha",
          "label": "Growing costs per hectare per harvest",
          "simple_label": "Seeds, fertiliser and field labour",
          "type": "variable_per_ha_cycle",
          "default": 450
        },
        {
          "key": "overheads",
          "label": "Fixed overheads",
          "simple_label": "People, power, transport and admin",
          "type": "fixed",
          "default": 60000
        }
      ],
      "capex_lines": [
        {
          "label": "Land clearing and preparation",
          "class": "land_improvement"
        },
        {
          "label": "Tractors and implements",
          "class": "equipment"
        },
        {
          "label": "Storage and drying",
          "class": "civil_works"
        }
      ],
      "ramp_up_default": [
        0.6,
        0.85,
        1
      ]
    },
    {
      "id": "irrigation",
      "label": "Irrigation and water infrastructure",
      "simple_label": "Irrigation",
      "examples": [
        "Scheme rehabilitation",
        "New irrigation scheme",
        "Dam and canal works"
      ],
      "illustration": "irrigation",
      "step2_title": "What will the water make possible?",
      "inputs": [
        {
          "key": "hectares",
          "label": "Irrigated area",
          "simple_label": "Land that will get water",
          "unit": "hectares",
          "default": 1000,
          "benchmark": false
        },
        {
          "key": "crop",
          "label": "Main crop",
          "simple_label": "What will farmers grow?",
          "type": "text",
          "default": "Rice"
        },
        {
          "key": "harvests_per_year",
          "label": "Crop cycles per year with irrigation",
          "simple_label": "Harvests each year",
          "unit": "per year",
          "default": 2,
          "benchmark": true
        },
        {
          "key": "yield_without",
          "label": "Yield without the project",
          "simple_label": "Crop per hectare today",
          "unit": "tonnes per harvest",
          "default": 2,
          "benchmark": true
        },
        {
          "key": "yield_per_ha",
          "label": "Yield with the project",
          "simple_label": "Crop per hectare with water",
          "unit": "tonnes per harvest",
          "default": 4,
          "benchmark": true
        },
        {
          "key": "price_per_tonne",
          "label": "Farm-gate price",
          "simple_label": "Expected selling price",
          "unit": "per tonne",
          "default": 300,
          "benchmark": true
        },
        {
          "key": "losses_pct",
          "label": "Post-harvest losses",
          "simple_label": "Crop lost before sale",
          "unit": "%",
          "default": 10
        },
        {
          "key": "water_fee_per_ha",
          "label": "Irrigation service fee",
          "simple_label": "Water fee farmers pay per hectare a year",
          "unit": "per hectare per year",
          "default": 0
        }
      ],
      "revenue_formula": "hectares * harvests_per_year * (yield_per_ha - yield_without) * (1 - losses_pct / 100) * price_per_tonne + hectares * water_fee_per_ha",
      "revenue_explained": "The extra crop the water makes possible, valued at the selling price, plus any water fees collected. For a public scheme this is the economic benefit, not cash the scheme owner receives.",
      "cost_lines": [
        {
          "key": "om_pct_capex",
          "label": "Operation and maintenance",
          "simple_label": "Keeping canals and pumps working",
          "type": "pct_of_capex",
          "default": 2
        },
        {
          "key": "input_cost_per_ha",
          "label": "Extra growing costs per hectare per harvest",
          "simple_label": "Extra seeds, fertiliser and labour",
          "type": "variable_per_ha_cycle",
          "default": 250
        }
      ],
      "capex_lines": [
        {
          "label": "Canals, pumps and drainage",
          "class": "irrigation"
        },
        {
          "label": "Dam and headworks",
          "class": "civil_works"
        },
        {
          "label": "Farmer training and support",
          "class": "other"
        }
      ],
      "ramp_up_default": [
        0.5,
        0.8,
        1
      ]
    },
    {
      "id": "livestock",
      "label": "Livestock and poultry",
      "simple_label": "Animals",
      "examples": [
        "Poultry",
        "Beef",
        "Dairy",
        "Pigs",
        "Fish"
      ],
      "illustration": "livestock",
      "step2_title": "How many animals, and what will they produce?",
      "inputs": [
        {
          "key": "herd_size",
          "label": "Herd or flock size",
          "simple_label": "Animals at full size",
          "unit": "animals",
          "default": 5000,
          "benchmark": false
        },
        {
          "key": "cycles_per_year",
          "label": "Production cycles per year",
          "simple_label": "Batches sold each year",
          "unit": "per year",
          "default": 6
        },
        {
          "key": "output_per_animal",
          "label": "Saleable output per animal per cycle",
          "simple_label": "What each animal produces per batch",
          "unit": "kg",
          "default": 2,
          "benchmark": true
        },
        {
          "key": "mortality_pct",
          "label": "Mortality",
          "simple_label": "Animals lost before sale",
          "unit": "%",
          "default": 5,
          "benchmark": true
