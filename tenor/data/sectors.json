  "glossary": {
    "DSCR": "How many times your spare cash covers your loan payments. Lenders usually want at least 1.3.",
    "LLCR": "The value of cash available over the rest of the loan, divided by what's still owed.",
    "IRR": "The yearly return the project earns on the money put in, over its whole life.",
    "NPV": "What all future cash is worth today, after allowing for the cost of waiting for it.",
    "Payback": "How many years until the cash coming in covers the money put in.",
    "Break-even": "The sales level where income just covers costs.",
    "Gearing": "How much of the project is paid for by debt rather than your own money.",
    "Runway": "How many months your cash lasts at the current rate of spending.",
    "CAPEX": "One-off money spent to build or buy things that last, like machines or buildings.",
    "OPEX": "The regular costs of running the business.",
    "EBITDA": "Profit before interest, tax and the wearing out of equipment.",
    "Depreciation": "Spreading the cost of equipment over the years it's used.",
    "Moratorium": "A period at the start of a loan when you don't repay the amount borrowed, and sometimes not the interest either.",
    "Tenor": "How long you have to repay a loan.",
    "Annuity": "Equal total payments each period, with interest falling and principal rising over time.",
    "Bullet": "Repaying the whole amount borrowed in one go at the end.",
    "Working capital": "Cash tied up in stock and unpaid customer bills, less bills you haven't paid yet.",
    "Take rate": "The share of each payment or loan that you keep as income."
  }
}