        {
          "key": "price_per_unit",
          "label": "Price per kg",
          "simple_label": "Selling price",
          "unit": "per kg",
          "default": 3,
          "benchmark": true
        }
      ],
      "revenue_formula": "herd_size * cycles_per_year * output_per_animal * (1 - mortality_pct / 100) * price_per_unit",
      "revenue_explained": "Animals, times batches a year, times what each produces, less losses, times the price.",
      "cost_lines": [
        {
          "key": "feed_cost_per_animal",
          "label": "Feed cost per animal per cycle",
          "simple_label": "Feed for each animal per batch",
          "type": "variable_per_animal_cycle",
          "default": 2.5
        },
        {
          "key": "vet_and_other",
          "label": "Veterinary and other variable costs",
          "simple_label": "Vet care and medicines",
          "type": "pct_of_revenue",
          "default": 5
        },
        {
          "key": "overheads",
          "label": "Fixed overheads",
          "simple_label": "Staff, power and admin",
          "type": "fixed",
          "default": 80000
        }
      ],
      "capex_lines": [
        {
          "label": "Housing and pens",
          "class": "livestock_infra"
        },
        {
          "label": "Processing and cold storage",
          "class": "plant"
        },
        {
          "label": "Vehicles",
          "class": "equipment"
        }
      ],
      "ramp_up_default": [
        0.5,
        0.8,
        1
      ]
    },
    {
      "id": "agro_processing",
      "label": "Agro-processing",
      "simple_label": "Processing crops",
      "examples": [
        "Rice mill",
        "Soybean crush",
        "Cassava flour",
        "Cocoa processing",
        "Feed mill"
      ],
      "illustration": "factory",
      "step2_title": "How much will you process?",
      "inputs": [
        {
          "key": "capacity_tpy",
          "label": "Installed capacity",
          "simple_label": "Most you could process in a year",
          "unit": "tonnes of input per year",
          "default": 20000,
          "benchmark": false
        },
        {
          "key": "utilisation_pct",
          "label": "Capacity utilisation",
          "simple_label": "How busy the plant will be",
          "unit": "%",
          "default": 60,
          "benchmark": true
        },
        {
          "key": "conversion_pct",
          "label": "Conversion rate",
          "simple_label": "Finished product from each tonne of input",
          "unit": "%",
          "default": 62,
          "hint": "For example, about 60 to 65% for paddy to milled rice",
          "benchmark": true
        },
        {
          "key": "product_price",
          "label": "Product price",
          "simple_label": "Selling price of the finished product",
          "unit": "per tonne",
          "default": 700,
          "benchmark": true
        },
        {
          "key": "input_price",
          "label": "Input cost",
          "simple_label": "What you pay for each tonne of raw crop",
          "unit": "per tonne",
          "default": 330
        },
        {
          "key": "byproduct_revenue_pct",
          "label": "By-product revenue",
          "simple_label": "Extra sales from husks, bran or meal",
          "unit": "% of main sales",
          "default": 3
        },
        {
          "key": "export_pct",
          "label": "Export share of sales",
          "simple_label": "Share you'll sell abroad",
          "unit": "%",
          "default": 0
        }
      ],
      "revenue_formula": "capacity_tpy * utilisation_pct / 100 * conversion_pct / 100 * product_price * (1 + byproduct_revenue_pct / 100)",
      "revenue_explained": "Tonnes processed, times how much finished product each tonne makes, times its price, plus by-product sales.",
      "cost_lines": [
        {
          "key": "input_price",
          "label": "Raw material",
          "simple_label": "Buying the raw crop",
          "type": "variable_per_input_tonne",
          "default": 330
        },
        {
          "key": "energy_per_tonne",
          "label": "Energy and consumables per input tonne",
          "simple_label": "Power, fuel and packaging",
          "type": "variable_per_input_tonne",
          "default": 25
        },
        {
          "key": "overheads",
          "label": "Fixed overheads",
          "simple_label": "Staff, maintenance and admin",
          "type": "fixed",
          "default": 250000
        }
      ],
      "capex_lines": [
        {
          "label": "Processing lines",
